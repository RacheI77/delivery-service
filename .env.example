# Delivery Service configuration template
# Copy this file to `.env` and fill in your own values
# The application reads from `.env` (config file) and environment variables
# override values defined in the file.

# HTTP server port
PORT=8080

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=delivery_db

# Google Maps Distance Matrix API
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api/distancematrix/json
GOOGLE_MAPS_API_KEY=YOUR_ACTUAL_API_KEY